# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Google Gemini API key — get one at https://aistudio.google.com/apikey
# If left empty, the app runs in mock mode (no real AI calls).
VITE_AI_API_KEY=

# Astra DataStax — get these from https://astra.datastax.com
# If left empty, History and Snippets tabs will be disabled.
VITE_ASTRA_ENDPOINT=https://<database-id>-<region>.apps.astra.datastax.com
VITE_ASTRA_TOKEN=AstraCS:...
VITE_ASTRA_KEYSPACE=Json_Lens
